# Raasta Backend Configuration
# Copy to .env and fill in your values

# Server
SERVER_PORT=8080
CORS_ORIGIN=https://raasta-mpxyck7w.manus.space

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=raasta
DB_PASSWORD=your_password_here
DB_NAME=raasta_db

# Admin Authentication
ADMIN_JWT_SECRET=change_this_to_a_random_secret_key
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=change_this_password

# Data Import
DATA_DIR=./data
LOG_LEVEL=info
