{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 240
    }
  },
  "rewrites": [
    {
      "source": "/api-proxy/api/v1/stations",
      "destination": "/api/v1/stations"
    },
    {
      "source": "/api-proxy/api/v1/routes/compare",
      "destination": "/api/v1/routes/compare"
    },
    {
      "source": "/_app/health",
      "destination": "/api/health"
    }
  ]
}
